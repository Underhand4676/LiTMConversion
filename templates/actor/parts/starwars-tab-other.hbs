<section class="tab {{tabs.other.id}} {{tabs.other.cssClass}} scrollable litm-sw-portrait-tab"
    id="other"
    data-tab="{{tabs.other.id}}"
    data-group="{{tabs.other.group}}">

    <div class="litm-sw-portrait-console">

        <div class="litm-sw-portrait-heading">
            <div>
                <div class="litm-sw-portrait-eyebrow">VISUAL IDENTIFICATION // SUBJECT FILE</div>
                <div class="litm-sw-portrait-title">CHARACTER PORTRAIT</div>
            </div>

            <div class="litm-sw-portrait-heading-right">
                <div class="litm-sw-portrait-code">RI/VIS-ID</div>

                {{#if system.editMode}}
                <div class="litm-sw-portrait-heading-actions">
                    <button
                        type="button"
                        class="litm-sw-portrait-button compact"
                        data-action="clickedCustomBackground"
                    >
                        <i class="fa-solid fa-image"></i>
                        {{#if system.customBackground}}
                            REPLACE
                        {{else}}
                            SELECT
                        {{/if}}
                    </button>

                    {{#if system.customBackground}}
                    <button
                        type="button"
                        class="litm-sw-portrait-button compact danger"
                        data-action="clickedRemoveCustomBackground"
                    >
                        <i class="fa-solid fa-trash"></i>
                        REMOVE
                    </button>
                    {{/if}}
                </div>
                {{/if}}
            </div>
        </div>


        <div class="litm-sw-portrait-stage">

            <div class="litm-sw-portrait-frame {{#if system.customBackground}}has-image{{else}}is-empty{{/if}}">

                {{#if system.customBackground}}
                    <img
                        class="litm-sw-portrait-image"
                        src="{{system.customBackground}}"
                        alt="{{actor.name}}"
                    >
                {{else}}
                    <div class="litm-sw-portrait-empty">
                        <i class="fa-solid fa-user-secret"></i>
                        <div>NO VISUAL RECORD ON FILE</div>
                        <span>SUBJECT IMAGE AWAITING ACQUISITION</span>
                    </div>
                {{/if}}

            </div>

        </div>


        <div class="litm-sw-portrait-help">
            VISUAL RECORD ENCRYPTED // DOSSIER ACCESS HASH VERIFIED
        </div>

    </div>

</section>
